{
  "name": "@teaql/teaql",
  "version": "0.1.13",
  "description": "TeaQL runtime and SQL data services for TypeScript",
  "files": [
    "dist",
    "!dist/.sql-root-owned-backup-*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sql/core": {
      "types": "./dist/sql/core.d.ts",
      "require": "./dist/sql/core.js",
      "default": "./dist/sql/core.js"
    },
    "./sql/postgres": {
      "types": "./dist/sql/postgres.d.ts",
      "require": "./dist/sql/postgres.js",
      "default": "./dist/sql/postgres.js"
    },
    "./sql/mysql": {
      "types": "./dist/sql/mysql.d.ts",
      "require": "./dist/sql/mysql.js",
      "default": "./dist/sql/mysql.js"
    },
    "./sql/sqlite": {
      "types": "./dist/sql/sqlite.d.ts",
      "require": "./dist/sql/sqlite.js",
      "default": "./dist/sql/sqlite.js"
    },
    "./sql/expo-sqlite": {
      "types": "./dist/sql/expo-sqlite.d.ts",
      "require": "./dist/sql/expo-sqlite.js",
      "default": "./dist/sql/expo-sqlite.js"
    },
    "./telemetry/opentelemetry": {
      "types": "./dist/telemetry/opentelemetry.d.ts",
      "require": "./dist/telemetry/opentelemetry.js",
      "default": "./dist/telemetry/opentelemetry.js"
    }
  },
  "typesVersions": {
    "*": {
      "sql/core": [
        "dist/sql/core.d.ts"
      ],
      "sql/postgres": [
        "dist/sql/postgres.d.ts"
      ],
      "sql/mysql": [
        "dist/sql/mysql.d.ts"
      ],
      "sql/sqlite": [
        "dist/sql/sqlite.d.ts"
      ],
      "sql/expo-sqlite": [
        "dist/sql/expo-sqlite.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepack": "npm run build"
  },
  "keywords": [
    "teaql",
    "query",
    "database"
  ],
  "author": "TeaQL",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teaql/teaql-ts.git"
  },
  "bugs": {
    "url": "https://github.com/teaql/teaql-ts/issues"
  },
  "homepage": "https://teaql.io",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^12.10.0",
    "jest": "^29.5.0",
    "jest-util": "^29.7.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "pg-query-stream": "^4.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "better-sqlite3": "^12.10.0",
    "expo-sqlite": "*",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "pg-query-stream": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  }
}
